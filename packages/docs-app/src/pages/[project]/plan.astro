---
import Layout from "../../layouts/Layout.astro";
import Sidebar from "../../components/Sidebar.astro";
import { getProjects } from "../../lib/projects";

export async function getStaticPaths() {
  return (await getProjects()).map((project) => ({
    params: { project: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<Layout title={`Plan · ${project.name}`} sidebar>
  <Sidebar project={project} view="plan" />

  <div class="content-column pt-14 pb-16 lg:pt-11">
    <main>
      <p class="mb-2 font-mono text-xs tracking-widest uppercase opacity-45">
        Work in progress
      </p>
      <h1 class="text-3xl font-bold tracking-tight">Plan</h1>
      <p class="mt-3 max-w-prose text-[0.95rem] leading-relaxed opacity-65">
        Planning documents for {project.name}.
      </p>

      {
        project.planFiles.length > 0 ? (
          <ul class="mt-7 divide-y overflow-hidden rounded-box border rule bg-base-100">
            {project.planFiles.map((file) => (
              <li class="flex items-center justify-between gap-4 px-4 py-3.5">
                <span class="min-w-0 truncate text-sm font-medium">{file.name}</span>
                <span class="shrink-0 font-mono text-[0.7rem] opacity-45">
                  {file.path}
                </span>
              </li>
            ))}
          </ul>
        ) : (
          <div class="mt-7 rounded-box border rule bg-base-100 p-6">
            <p class="text-sm opacity-60">No plan files yet.</p>
          </div>
        )
      }
    </main>
  </div>
</Layout>
