---
import CopyCommand from "../components/CopyCommand.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import Layout from "../layouts/Layout.astro";
import { getProjects, shortenPath } from "../lib/projects";

const projects = await getProjects();
---

<Layout
  title="mdxctl — projects"
  description="All docs projects registered with mdxctl on this machine"
>
  {/* No chrome on the index: the toggle just floats over the paper. */}
  <div class="fixed top-4 right-4 z-20">
    <ThemeToggle />
  </div>

  <main class="mx-auto w-full max-w-5xl px-5 pt-14 pb-20">
    <div class="mb-10 flex items-center gap-2.5">
      <svg
        viewBox="0 0 64 56"
        fill="currentColor"
        class="h-5 w-auto"
        aria-hidden="true"
      >
        <path d="M14.5156 2.00933C15.24 0.765957 16.5788 2.4579e-6 18.0277 2.48372e-6L45.9723 0C47.4211 0 48.76.765946 49.4844 2.00932L63.4567 25.9907C64.1811 27.234 64.1811 28.7659 63.4567 30.0093L52.7013 48.4693L49.1892 42.4413L57.6032 28L44.8016 6.02797L19.1984 6.02797L10.8279 20.3947H3.80373L14.5156 2.00933Z"
        ></path>
        <path d="M44.8618 49.8686L48.0897 55.4088C47.4628 55.789 46.7327 56 45.9723 56H18.0277C16.5789 56 15.24 55.2341 14.5156 53.9907L.543322 30.0093C.168863 29.3666-.0120378 28.6468.000620907 27.9296L30.3455 27.9294C31.4345 27.9294 32.4404 28.5063 32.9828 29.442L44.8432 49.9007L44.8618 49.8686Z"
        ></path>
      </svg>
      <span class="font-mono text-[0.95rem] font-semibold tracking-tight"
        >mdxctl</span
      >
    </div>
    {
      projects.length === 0 ? (
        <section class="mx-auto max-w-xl py-10 text-center">
          <div class="mx-auto mb-7 grid size-14 place-items-center rounded-box border rule bg-base-100 shadow-sm">
            <svg
              class="size-6 text-primary"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M4 7a2 2 0 0 1 2-2h3l2 2h7a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z" />
              <path d="M12 10v5m-2.5-2.5h5" />
            </svg>
          </div>

          <h1 class="text-3xl font-bold tracking-tight">
            Setup mdxctl in your project
          </h1>
          <p class="mx-auto mt-3 max-w-md text-[0.95rem] leading-relaxed opacity-65">
            No projects are registered yet. Run this in any project folder — it
            creates <span class="font-mono text-[0.85em]">.mdxctl/docs</span> and
            registers the folder so it shows up here.
          </p>

          <div class="mt-7 flex justify-center">
            <CopyCommand command="mdxctl init" />
          </div>

          <p class="mt-4 text-xs opacity-45">
            Click to copy · then restart{" "}
            <span class="font-mono">mdxctl start</span> and refresh this page
          </p>
        </section>
      ) : (
        <>
          <section class="mb-9">
            <h1 class="text-4xl font-bold tracking-tight">Your projects</h1>
            <p class="mt-2.5 text-[0.95rem] opacity-60">
              {projects.length} registered{" "}
              {projects.length === 1 ? "folder" : "folders"}
            </p>
          </section>

          <ul class="grid gap-3.5 sm:grid-cols-2">
            {projects.map((project) => (
              <li>
                <a
                  href={`/${project.slug}`}
                  class="group card-surface flex h-full flex-col gap-3 rounded-box border rule bg-base-100 p-5 shadow-sm transition duration-150 hover:border-primary hover:shadow-md"
                >
                  <div class="flex items-start justify-between gap-3">
                    <span class="font-mono text-lg leading-tight font-semibold tracking-tight">
                      {project.name}
                    </span>
                    <span
                      class:list={[
                        "shrink-0 rounded-selector px-2 py-0.5 text-[0.7rem] font-medium",
                        project.pages.length > 0
                          ? "badge-docs"
                          : project.linked
                            ? "bg-base-200 opacity-70"
                            : "badge-restart",
                      ]}
                    >
                      {project.pages.length > 0
                        ? `${project.pages.length} ${project.pages.length === 1 ? "doc" : "docs"}`
                        : project.linked
                          ? "empty"
                          : "restart to load"}
                    </span>
                  </div>

                  {project.home?.description && (
                    <p class="line-clamp-2 text-sm leading-relaxed opacity-70">
                      {project.home.description}
                    </p>
                  )}

                  <div class="mt-auto flex items-end justify-between gap-3">
                    <span
                      class="truncate font-mono text-[0.7rem] opacity-45"
                      title={project.path ?? project.slug}
                    >
                      {project.path ? shortenPath(project.path) : "linked folder"}
                    </span>
                    <span class="flex items-center gap-1 font-mono text-xs text-primary opacity-0 transition group-hover:opacity-100">
                      /{project.slug}
                      <svg
                        class="size-3.5 transition-transform group-hover:translate-x-0.5"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M5 12h14m-6-6 6 6-6 6" />
                      </svg>
                    </span>
                  </div>
                </a>
              </li>
            ))}
          </ul>

          <section class="mt-10 flex flex-wrap items-center gap-x-4 gap-y-3 border-t rule pt-6">
            <p class="text-sm opacity-60">Add another project</p>
            <CopyCommand command="mdxctl init" variant="ghost" />
            <CopyCommand command="mdxctl add" variant="ghost" />
          </section>
        </>
      )
    }
  </main>
</Layout>
