---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** True on project pages, which render a fixed sidebar rail. */
  sidebar?: boolean;
}

const { title = "mdxctl", description, sidebar = false } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="mdxctl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#faf7f5" />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
    <ClientRouter />
    {/* Applied before first paint so a saved dark theme never flashes light. */}
    <script is:inline>
      (() => {
        let theme = "mdxctl";
        try {
          if (localStorage.getItem("mdxctl-theme") === "mdxctl-dark") {
            theme = "mdxctl-dark";
          }
        } catch {
          /* storage unavailable — fall back to the light default */
        }
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme =
          theme === "mdxctl-dark" ? "dark" : "light";
      })();
    </script>
    {/*
      The rail ships "settled" (no animation) so a direct load or refresh never
      slides. Coming from a page *without* a rail — i.e. the index — the flag is
      stripped from the incoming rail so the slide-in plays exactly once.

      This must run before paint, so it is inline and in <head>: the incoming
      page's module scripts only run after the swap.
    */}
    <script is:inline>
      if (!window.__mdxctlSidebarHook) {
        window.__mdxctlSidebarHook = true;
        document.addEventListener("astro:before-swap", (event) => {
          const from = document.querySelector("[data-sidebar]");
          const to = event.newDocument.querySelector("[data-sidebar]");
          if (to && !from) to.removeAttribute("data-sidebar-settled");
        });
      }
    </script>
  </head>
  <body
    class:list={[
      "bg-paper min-h-screen bg-base-100 text-base-content antialiased",
      sidebar && "has-sidebar",
    ]}
  >
    <slot />
  </body>
</html>
