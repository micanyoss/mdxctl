---
/**
 * Light/dark toggle for the header.
 *
 * The active theme lives in localStorage under "mdxctl-theme" and is applied by
 * the inline bootstrap script in Layout.astro before first paint, so a reload
 * (or a fresh `mdxctl start`) keeps whatever the reader picked. Default: light.
 *
 * The glyph is a single circle that animates between a sun (rays out) and a
 * moon (rays in, bite taken out by a masked circle).
 */
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<button
  type="button"
  class:list={["theme-toggle", className]}
  data-theme-toggle
  title="Toggle light / dark theme"
  aria-label="Toggle light / dark theme"
  aria-live="polite"
>
  <svg
    class="theme-toggle__glyph"
    viewBox="0 0 24 24"
    fill="currentColor"
    stroke="currentColor"
    stroke-width="1.65"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <mask id="theme-toggle-moon">
      <rect x="0" y="0" width="24" height="24" fill="white"></rect>
      <circle class="theme-toggle__bite" cx="26" cy="8" r="6" fill="black"
      ></circle>
    </mask>

    <circle
      class="theme-toggle__orb"
      cx="12"
      cy="12"
      r="5.25"
      mask="url(#theme-toggle-moon)"
      stroke="none"></circle>

    <g class="theme-toggle__rays">
      <line x1="12" y1="1.6" x2="12" y2="3.4"></line>
      <line x1="12" y1="20.6" x2="12" y2="22.4"></line>
      <line x1="1.6" y1="12" x2="3.4" y2="12"></line>
      <line x1="20.6" y1="12" x2="22.4" y2="12"></line>
      <line x1="4.6" y1="4.6" x2="5.9" y2="5.9"></line>
      <line x1="18.1" y1="18.1" x2="19.4" y2="19.4"></line>
      <line x1="4.6" y1="19.4" x2="5.9" y2="18.1"></line>
      <line x1="18.1" y1="5.9" x2="19.4" y2="4.6"></line>
    </g>
  </svg>
</button>

<style>
  .theme-toggle {
    position: relative;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.125rem;
    height: 2.125rem;
    cursor: pointer;
    border-radius: 9999px;
    color: var(--color-base-content);
    background: transparent;
    transition:
      background-color 200ms ease,
      transform 200ms ease;
  }

  .theme-toggle:hover {
    background: color-mix(in oklch, var(--color-base-200) 90%, transparent);
  }

  .theme-toggle:active {
    transform: scale(0.92);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .theme-toggle__glyph {
    width: 1.15rem;
    height: 1.15rem;
    overflow: visible;
  }

  /* --- light: full sun ---------------------------------------------------- */
  .theme-toggle__orb {
    transform-origin: center;
    transition: transform 500ms cubic-bezier(0.34, 1.35, 0.64, 1);
  }

  .theme-toggle__bite {
    transition: transform 500ms cubic-bezier(0.45, 0, 0.3, 1);
  }

  .theme-toggle__rays {
    transform-origin: center;
    transition:
      transform 500ms cubic-bezier(0.34, 1.35, 0.64, 1),
      opacity 300ms ease;
  }

  /* --- dark: rays retract, the bite slides in to carve a crescent --------- */
  :global([data-theme="mdxctl-dark"]) .theme-toggle__orb {
    transform: scale(1.5);
  }

  :global([data-theme="mdxctl-dark"]) .theme-toggle__bite {
    transform: translate(-9px, 2px);
  }

  :global([data-theme="mdxctl-dark"]) .theme-toggle__rays {
    transform: rotate(-25deg) scale(0.4);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle,
    .theme-toggle__orb,
    .theme-toggle__bite,
    .theme-toggle__rays {
      transition: none;
    }

    .theme-toggle:active {
      transform: none;
    }
  }
</style>

<script>
  const LIGHT = "mdxctl";
  const DARK = "mdxctl-dark";
  const STORAGE_KEY = "mdxctl-theme";

  /** Surface colours per theme, kept in sync with the browser chrome. */
  const THEME_COLOR: Record<string, string> = {
    [LIGHT]: "#faf7f5",
    [DARK]: "#0e0a08",
  };

  function current(): string {
    return document.documentElement.dataset.theme === DARK ? DARK : LIGHT;
  }

  function stored(): string {
    try {
      return localStorage.getItem(STORAGE_KEY) === DARK ? DARK : LIGHT;
    } catch {
      return LIGHT;
    }
  }

  function apply(theme: string): void {
    const root = document.documentElement;
    root.dataset.theme = theme;
    root.style.colorScheme = theme === DARK ? "dark" : "light";

    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute("content", THEME_COLOR[theme] ?? THEME_COLOR[LIGHT]);

    for (const button of document.querySelectorAll("[data-theme-toggle]")) {
      button.setAttribute(
        "aria-label",
        theme === DARK ? "Switch to light theme" : "Switch to dark theme",
      );
    }
  }

  /**
   * Surface colours only animate while the user is actually switching — the
   * class is dropped once the fade lands so navigation stays snappy.
   */
  function toggle(): void {
    const next = current() === DARK ? LIGHT : DARK;
    const root = document.documentElement;

    root.classList.add("theme-animating");
    apply(next);

    try {
      localStorage.setItem(STORAGE_KEY, next);
    } catch {
      // Private mode / storage disabled: the theme just won't persist.
    }

    window.setTimeout(() => root.classList.remove("theme-animating"), 450);
  }

  document.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement | null)?.closest(
      "[data-theme-toggle]",
    );
    if (button) toggle();
  });

  // A client-side navigation copies the incoming page's <html> attributes over
  // ours, resetting data-theme to the server-rendered light default — so restore
  // from storage rather than from the (just-clobbered) DOM.
  document.addEventListener("astro:after-swap", () => apply(stored()));
  apply(stored());
</script>
