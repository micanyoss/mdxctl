---
/**
 * Full-width Docs / Plan switch that lives directly under the sidebar search.
 *
 * Both halves are always the same width, and the active half is a raised pill
 * so the control reads as a segmented switch rather than two links.
 */
interface Props {
  project: string;
  active: "docs" | "plan";
  class?: string;
}

const { project, active, class: className = "" } = Astro.props;

const views = [
  { id: "docs", label: "Docs", href: `/${project}` },
  { id: "plan", label: "Plan", href: `/${project}/plan` },
] as const;
---

<nav
  class:list={["view-switch", className]}
  aria-label="Project view"
  data-active={active}
>
  <span class="view-switch__thumb" aria-hidden="true"></span>
  {
    views.map((view) => (
      <a
        href={view.href}
        class="view-switch__item"
        aria-current={active === view.id ? "page" : undefined}
      >
        {view.label}
      </a>
    ))
  }
</nav>

<style>
  .view-switch {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.125rem;
    padding: 0.1875rem;
    /* Sits on the rail like the search bar: opaque track, hairline, shadow. */
    border: 1px solid color-mix(in oklch, var(--color-base-300) 95%, transparent);
    border-radius: var(--radius-field);
    background: color-mix(in oklch, var(--color-base-300) 38%, var(--color-base-100));
    box-shadow:
      0 1px 1px color-mix(in oklch, oklch(20% 0.02 62) 5%, transparent),
      0 2px 5px -2px color-mix(in oklch, oklch(20% 0.02 62) 14%, transparent);
    isolation: isolate;
  }

  :global([data-theme="mdxctl-dark"]) .view-switch {
    border-color: color-mix(in oklch, var(--color-base-300) 86%, transparent);
    background: color-mix(in oklch, var(--color-base-300) 36%, var(--color-base-200));
    box-shadow: 0 2px 6px -2px color-mix(in oklch, oklch(0% 0 0) 28%, transparent);
  }

  /* Slides between halves instead of repainting a background per item. */
  .view-switch__thumb {
    position: absolute;
    z-index: -1;
    top: 0.1875rem;
    bottom: 0.1875rem;
    left: 0.1875rem;
    width: calc(50% - 0.25rem);
    border-radius: calc(var(--radius-field) - 0.15rem);
    background: var(--color-base-100);
    box-shadow:
      0 1px 2px color-mix(in oklch, oklch(20% 0.02 62) 18%, transparent),
      0 0 0 1px color-mix(in oklch, var(--color-base-300) 55%, transparent);
    transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* The active thumb is intentionally brighter than both track and border. */
  :global([data-theme="mdxctl-dark"]) .view-switch__thumb {
    background: color-mix(in oklch, var(--color-base-300) 86%, var(--color-base-content));
    box-shadow:
      0 1px 4px color-mix(in oklch, oklch(0% 0 0) 42%, transparent),
      0 0 0 1px color-mix(in oklch, var(--color-base-content) 16%, var(--color-base-300));
  }

  .view-switch[data-active="plan"] .view-switch__thumb {
    transform: translateX(calc(100% + 0.125rem));
  }

  .view-switch__item {
    display: grid;
    place-items: center;
    height: 1.85rem;
    border-radius: calc(var(--radius-field) - 0.15rem);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--color-base-content);
    text-decoration: none;
    opacity: 0.5;
    transition: opacity 180ms ease, color 180ms ease;
  }

  .view-switch__item:hover {
    opacity: 0.9;
  }

  .view-switch__item[aria-current="page"] {
    opacity: 1;
  }

  .view-switch__item:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 1px;
  }

  @media (prefers-reduced-motion: reduce) {
    .view-switch__thumb {
      transition: none;
    }
  }
</style>
